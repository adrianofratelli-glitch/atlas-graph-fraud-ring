# ===== MongoDB Atlas =====
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB=graph_grupo_economico

# ===== Atlas Search / Vector Search =====
ATLAS_SEARCH_INDEX_NAME=companies_name_resolution
PEOPLE_SEARCH_INDEX_NAME=people_name_resolution
VECTOR_INDEX_NAME=activities_vector

# ===== Embeddings (Voyage) =====
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3-lite
EMBEDDING_DIMENSIONS=512

# ===== App =====
BACKEND_PORT=8350
FRONTEND_PORT=5350
GRAPH_MAX_DEPTH_CAP=6
GRAPH_DEFAULT_DEPTH=4
HUB_FANOUT_THRESHOLD=50
LOG_LEVEL=INFO
GRAPH_MAX_NODES=1200

# ===== Caso de negócio =====
# NÃO são medições: são os números do cliente, e a tela os rotula como tais.
ANALYST_HOURS_PER_CASE=4
ANALYST_COST_PER_HOUR=120
CURRENCY=R$
GRAPH_MAX_TIME_MS=15000
